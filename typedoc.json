{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/types.ts"
  ],
  "outputs": [
    {
      "name": "html",
      "path": "./docs/api"
    }
  ],
  "exclude": [
    "scripts/**/*",
    "test/**/*"
  ],
  "tsconfig": "tsconfig.json",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "includeVersion": true,
  "sort": [
    "source-order"
  ],
  "readme": "none",
  "gitRevision": "{branch}"
}
