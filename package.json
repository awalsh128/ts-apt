{
  "name": "ts-apt",
  "version": "0.0.0-semantically-released",
  "description": "TypeScript APT and APT-fast package management library",
  "author": "Andrew Walsh",
  "license": "Apache-2.0",
  "keywords": [
    "apt",
    "apt-cache",
    "apt-get",
    "apt-fast",
    "helper"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/awalsh128"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/awalsh128/ts-apt.git"
  },
  "files": [
    "dist/src",
    "!dist/test",
    "scripts/dist",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "apt-fast": "./scripts/dist/apt-fast.sh"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/types.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "require": {
        "types": "./dist/src/index.d.cts",
        "default": "./dist/src/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "runall": "node ./node_modules/npm-run-all/bin/npm-run-all/index.js",
    "build:lib": "npx tsc -p tsconfig.build.json",
    "build:scripts": "npx tsc -p tsconfig.scripts.json --noEmit",
    "build": "npm run -s runall -- build:lib build:scripts",
    "prepare": "husky && npm run -s build:lib",
    "clean": "rm -rf dist coverage",
    "script": "node --experimental-strip-types",
    "check:latest-action-pin": "npm run script -- ./scripts/ops/check_latest_action_pin.mts",
    "check:latest-action-pins": "npm run script -- ./scripts/ops/check_latest_action_pin.mts --scan",
    "check:pr": "npm run script -- ./scripts/ops/pr_checks.mts",
    "check:configs": "npm run script -- ./scripts/ops/check_configs.mts",
    "check": "npm run -s runall -- check:latest-action-pins check:pr check:configs",
    "gh:auth": "gh auth status >/dev/null 2>&1 || gh auth login --web && gh auth setup-git",
    "setup:dev": "npm run script -- ./scripts/dev/setup_devenv.mts",
    "ghsync": "npm run script -- ./scripts/dev/gh_sync.mts",
    "repo:rulesets:download": "npm run ghsync -- download --target rulesets",
    "repo:rulesets:upload": "npm run ghsync -- upload --target rulesets",
    "repo:settings:download": "npm run ghsync -- download --target settings",
    "repo:settings:upload": "npm run ghsync -- upload --target settings",
    "repo:vars:download": "npm run ghsync -- download --target vars",
    "repo:vars:upload": "npm run ghsync -- upload --target vars",
    "repo:tags:download": "npm run ghsync -- download --target tags",
    "repo:tags:upload": "npm run ghsync -- upload --target tags",
    "repo:all:download": "npm run ghsync -- download --target all",
    "repo:all:upload": "npm run ghsync -- upload --target all",
    "docs:api": "typedoc --options typedoc.json",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "lint": "eslint src test scripts --ext .ts,.mts",
    "typecheck:lib": "npx tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "npx tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "npm run -s runall -- typecheck:lib typecheck:scripts",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude test/ubuntu.integration.test.ts --exclude test/ubuntu.mutating.integration.test.ts --coverage",
    "test:integration": "vitest run test/ubuntu.integration.test.ts test/ubuntu.mutating.integration.test.ts",
    "test:integration:docker": "TS_APT_FORCE_DEVCONTAINER=true vitest run test/ubuntu.integration.test.ts test/ubuntu.mutating.integration.test.ts",
    "test": "npm run -s test:unit && npm run -s test:integration",
    "dev": "vitest",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@devcontainers/cli": "^0.90.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "async-mutex": "^0.5.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "semantic-release": "^25.0.9",
    "type-coverage": "^2.31.2",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "zodline": "^0.3.2"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
